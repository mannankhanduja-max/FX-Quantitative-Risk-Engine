.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Editors
# ------------------------------------------------------------
.vscode/
.idea/
*.swp

# ------------------------------------------------------------
# Generated output
#
# Market data and results are reproducible by running main.py,
# so they do not belong in version control. Directories are
# kept via .gitkeep so the pipeline has somewhere to write.
# ------------------------------------------------------------
data/raw/*
data/processed/*
results/tables/*
results/figures/*

!data/raw/.gitkeep
!data/processed/.gitkeep
!results/tables/.gitkeep
!results/figures/.gitkeep
