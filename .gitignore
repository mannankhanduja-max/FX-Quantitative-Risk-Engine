# HistData archives are large and redistributable only from source.
data/histdata/*
!data/histdata/.gitkeep

results/*
!results/.gitkeep

data/raw/*
data/processed/*
results/tables/*
results/figures/*

# Vendor market data. Regenerated by `python fetch_data.py` in
# seconds, so committing it buys little and costs a lot: Yahoo's
# terms restrict redistribution, and a re-fetch rewrites every
# file, producing multi-megabyte diffs that bury the code changes.
data/yahoo/*
!data/yahoo/.gitkeep
